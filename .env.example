# Supabase Configuration for WhyUndefeated
# Replace with your Supabase project credentials (found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Umami Analytics Configuration for Public Telemetry
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_PUBLIC_URL=https://cloud.umami.is/share/your-share-id/whyundefeated

